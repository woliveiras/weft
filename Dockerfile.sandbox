# Default image for docker-isolated tool sandboxes (isolation.mode: docker).
# One long-lived container per replica; commands run via `docker exec` with
# the replica workspace bind-mounted at /workspace and no network by default.
# With Docker Compose it is built inside the dedicated sandbox-daemon by the
# sandbox-image service (`docker compose up sandbox-image` after editing);
# outside Compose: docker build -f Dockerfile.sandbox -t weft/sandbox:latest .
FROM golang:1.26-alpine
RUN apk add --no-cache git make ca-certificates \
 && addgroup -g 10001 sandbox && adduser -D -u 10001 -G sandbox sandbox
ENV GO111MODULE=auto GOCACHE=/tmp/go-build GOTOOLCHAIN=local
USER 10001:10001
WORKDIR /workspace
CMD ["sleep", "infinity"]
