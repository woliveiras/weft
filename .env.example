# Generate unique values locally with: openssl rand -hex 32
# Keep the populated .env file private and never commit it.
WEFT_ADMIN_TOKEN=
WEFT_RUNTIME_SECRET=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Optional: key for a hosted OpenAI-compatible endpoint (e.g. Gemini), used only by
# make test-llm-cloud and make eval-cloud. Configure providers for Weft itself in the console.
WEFT_CLOUD_API_KEY=
